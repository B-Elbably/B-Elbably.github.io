---
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const links = [
  { href: '/', label: 'Home' },
  { href: '/skills', label: 'Skills' },
  { href: '/projects', label: 'Missions' },
  { href: '/cp', label: 'Arena' },
  { href: '/community', label: 'Crew' },
  { href: '/contact', label: 'Contact' },
];
---

<header class="site-header">
  <div class="wrap header-row">
    <a class="wordmark" href="/" aria-label="bably.me home">
      <span class="wordmark-star" aria-hidden="true"></span>
      <span>BABLY.ME</span>
    </a>

    <button class="menu-btn" type="button" aria-expanded="false" aria-controls="site-nav" data-menu>
      <span class="sr-only">Toggle menu</span>
      <span aria-hidden="true">MENU</span>
    </button>

    <nav id="site-nav" class="site-nav" aria-label="Main">
      <ul>
        {
          links.map((l) => (
            <li>
              <a href={l.href} aria-current={path === l.href ? 'page' : undefined}>
                {l.label}
              </a>
            </li>
          ))
        }
      </ul>
      <button class="motion-btn" type="button" data-motion-toggle aria-pressed="true">
        <span aria-hidden="true" class="motion-dot"></span>
        <span data-motion-label>MOTION ON</span>
      </button>
    </nav>
  </div>
</header>
