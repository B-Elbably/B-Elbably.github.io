---
import '@fontsource/press-start-2p/latin-400.css';
import '@fontsource/vt323/latin-400.css';
import '@fontsource-variable/inter/wght.css';
import '../styles/global.css';

import Starfield from '../components/Starfield.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import profiles from '../data/profiles.json';
import {
  NAME,
  OG_IMAGE,
  OG_IMAGE_ALT,
  PERSON_ID,
  WEBSITE_ID,
  breadcrumbNode,
  lastModified,
  personNode,
  serializeJsonLd,
  url,
  websiteNode,
} from '../lib/site.js';

interface Props {
  title: string;
  description: string;
  /** schema.org type of this page. */
  pageType?: 'WebPage' | 'ProfilePage' | 'CollectionPage' | 'ContactPage' | 'AboutPage';
  /** Label for this page in the breadcrumb trail (defaults to the title). */
  crumb?: string;
  /** Extra schema.org nodes for this page, added to the JSON-LD graph. */
  graph?: Record<string, unknown>[];
  /** Open Graph type; the home page uses "profile". */
  ogType?: 'website' | 'profile';
  noindex?: boolean;
}

const {
  title,
  description,
  pageType = 'WebPage',
  crumb,
  graph = [],
  ogType = 'website',
  noindex = false,
} = Astro.props;

const isHome = Astro.url.pathname === '/';
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = url(OG_IMAGE.path);
const fullTitle = isHome ? `${NAME} | Backend engineer and competitive programmer` : `${title} | ${NAME}`;
const robots = noindex ? 'noindex, nofollow' : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1';

// One JSON-LD graph per page: site, person, the page itself, breadcrumbs and any page-specific nodes.
// The full Person node is repeated on every page on purpose: crawlers read pages independently.
const pageNode = {
  '@type': pageType,
  '@id': `${canonical}#webpage`,
  url: canonical,
  name: fullTitle,
  description,
  inLanguage: 'en',
  isPartOf: { '@id': WEBSITE_ID },
  ...(pageType === 'ProfilePage' ? { mainEntity: { '@id': PERSON_ID } } : { about: { '@id': PERSON_ID } }),
  primaryImageOfPage: { '@type': 'ImageObject', url: ogImage, width: OG_IMAGE.width, height: OG_IMAGE.height },
  ...(lastModified ? { dateModified: lastModified } : {}),
  ...(isHome ? {} : { breadcrumb: { '@id': `${canonical}#breadcrumb` } }),
};
const jsonLd = noindex
  ? undefined
  : serializeJsonLd([
      websiteNode(),
      personNode(),
      pageNode,
      ...(isHome ? [] : [breadcrumbNode(canonical, crumb ?? title)]),
      ...graph,
    ]);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={NAME} />
    <meta name="robots" content={robots} />
    <meta name="theme-color" content="#070a1a" />
    {!noindex && <link rel="canonical" href={canonical} />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
    <link rel="alternate" type="text/plain" href="/llms.txt" title="Summary for language models (llms.txt)" />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={NAME} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content={String(OG_IMAGE.width)} />
    <meta property="og:image:height" content={String(OG_IMAGE.height)} />
    <meta property="og:image:alt" content={OG_IMAGE_ALT} />
    {
      ogType === 'profile' && (
        <>
          <meta property="profile:first_name" content="Belal" />
          <meta property="profile:last_name" content="Elbably" />
          <meta property="profile:username" content={profiles.handle} />
        </>
      )
    }
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={OG_IMAGE_ALT} />

    {jsonLd && <script type="application/ld+json" set:html={jsonLd} />}

    <!-- Runs before first paint: reduced-motion users start with motion off. -->
    <script is:inline>
      (function () {
        var r = document.documentElement;
        r.classList.add('js');
        var m = 'on';
        try {
          var saved = localStorage.getItem('motion');
          if (saved === 'on' || saved === 'off') m = saved;
          else if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) m = 'off';
        } catch (e) {}
        r.dataset.motion = m;
      })();
    </script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <Starfield />
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />

    <script>
      const root = document.documentElement;
      const motionOn = () => root.dataset.motion !== 'off';

      // ---- Motion toggle -------------------------------------------------
      const mBtn = document.querySelector('[data-motion-toggle]');
      const mLabel = document.querySelector('[data-motion-label]');
      function syncMotionUI() {
        const on = motionOn();
        mBtn?.setAttribute('aria-pressed', String(on));
        if (mLabel) mLabel.textContent = on ? 'MOTION ON' : 'MOTION OFF';
      }
      mBtn?.addEventListener('click', () => {
        const next = motionOn() ? 'off' : 'on';
        root.dataset.motion = next;
        try {
          localStorage.setItem('motion', next);
        } catch (e) {}
        syncMotionUI();
        window.dispatchEvent(new Event('motionchange'));
      });
      syncMotionUI();

      // ---- Mobile menu ---------------------------------------------------
      const menuBtn = document.querySelector('[data-menu]');
      menuBtn?.addEventListener('click', () => {
        const open = menuBtn.getAttribute('aria-expanded') === 'true';
        menuBtn.setAttribute('aria-expanded', String(!open));
        document.querySelector('.site-header')?.toggleAttribute('data-open', !open);
      });

      // ---- Scroll reveal -------------------------------------------------
      const reveals = document.querySelectorAll('.reveal');
      if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (e.isIntersecting) {
                e.target.classList.add('in');
                io.unobserve(e.target);
              }
            }
          },
          { threshold: 0.12 },
        );
        reveals.forEach((el) => io.observe(el));
      } else {
        reveals.forEach((el) => el.classList.add('in'));
      }

      // ---- Count-up stats (final number is in the HTML for no-JS) --------
      const counters = document.querySelectorAll<HTMLElement>('[data-count]');
      const fmt = (el: HTMLElement, v: number) =>
        `${el.dataset.prefix ?? ''}${v.toLocaleString('en-US')}${el.dataset.suffix ?? ''}`;
      if (motionOn()) counters.forEach((el) => (el.textContent = fmt(el, 0)));
      if ('IntersectionObserver' in window) {
        const cio = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (!e.isIntersecting) continue;
              const el = e.target as HTMLElement;
              cio.unobserve(el);
              const end = Number(el.dataset.count);
              if (!motionOn()) {
                el.textContent = fmt(el, end);
                continue;
              }
              const steps = 22;
              let i = 0;
              const timer = setInterval(() => {
                i++;
                el.textContent = fmt(el, Math.round((end * i) / steps));
                if (i >= steps) clearInterval(timer);
              }, 45);
            }
          },
          { threshold: 0.4 },
        );
        counters.forEach((el) => cio.observe(el));
      } else {
        counters.forEach((el) => (el.textContent = fmt(el, Number(el.dataset.count))));
      }

      // ---- Typing tagline ------------------------------------------------
      document.querySelectorAll<HTMLElement>('[data-typing]').forEach((host) => {
        const lines: string[] = JSON.parse(host.dataset.lines ?? '[]');
        const out = host.querySelector('.typed');
        if (!out || lines.length === 0) return;
        let li = 0;
        let ci = 0;
        let deleting = false;
        let timer: number | undefined;

        function tick() {
          if (!motionOn()) {
            out!.textContent = lines[0];
            return;
          }
          const line = lines[li];
          if (!deleting) {
            ci++;
            out!.textContent = line.slice(0, ci);
            if (ci >= line.length) {
              deleting = true;
              timer = window.setTimeout(tick, 1700);
              return;
            }
            timer = window.setTimeout(tick, 55);
          } else {
            ci--;
            out!.textContent = line.slice(0, ci);
            if (ci <= 0) {
              deleting = false;
              li = (li + 1) % lines.length;
              timer = window.setTimeout(tick, 350);
              return;
            }
            timer = window.setTimeout(tick, 24);
          }
        }
        function restart() {
          window.clearTimeout(timer);
          li = 0;
          ci = 0;
          deleting = false;
          if (motionOn()) tick();
          else out!.textContent = lines[0];
        }
        window.addEventListener('motionchange', restart);
        restart();
      });

      // ---- Project filter ------------------------------------------------
      const chips = document.querySelectorAll<HTMLButtonElement>('[data-filter]');
      const cards = document.querySelectorAll<HTMLElement>('[data-project]');
      chips.forEach((chip) =>
        chip.addEventListener('click', () => {
          const f = chip.dataset.filter;
          chips.forEach((c) => c.setAttribute('aria-pressed', String(c === chip)));
          cards.forEach((card) => {
            const tags = (card.dataset.tags ?? '').split(' ');
            card.hidden = !(f === 'all' || tags.includes(f ?? ''));
          });
        }),
      );

      // ---- Konami code: meteor shower -----------------------------------
      const code = ['ArrowUp', 'ArrowUp', 'ArrowDown', 'ArrowDown', 'ArrowLeft', 'ArrowRight', 'ArrowLeft', 'ArrowRight', 'b', 'a'];
      let pos = 0;
      window.addEventListener('keydown', (e) => {
        const k = e.key.length === 1 ? e.key.toLowerCase() : e.key;
        pos = k === code[pos] ? pos + 1 : k === code[0] ? 1 : 0;
        if (pos === code.length) {
          pos = 0;
          window.dispatchEvent(new Event('meteors'));
          const toast = document.createElement('div');
          toast.className = 'toast';
          toast.setAttribute('role', 'status');
          toast.textContent = motionOn() ? 'METEOR SHOWER!' : 'Turn motion on for the meteor shower.';
          document.body.appendChild(toast);
          setTimeout(() => toast.remove(), 3200);
        }
      });
    </script>
  </body>
</html>
